+/* Face unlock is set up in its own window; the row shows whether the user
+ * has a face enrolled and opens that window. It manages the current user. */
+#define FACE_UNLOCK_APP "org.erhai.FaceUnlock.desktop"
+#define FACE_UNLOCK_STORE "/var/lib/erhai-face"
+
+static void
+update_face_row_state (CcUserPage *self)
+{
+    g_autoptr(GDesktopAppInfo) app = g_desktop_app_info_new (FACE_UNLOCK_APP);
+    g_autofree gchar *path = NULL;
+    gboolean visible;
+
+    visible = app != NULL && is_current_user (self->user) &&
+              act_user_is_local_account (self->user);
+    gtk_widget_set_visible (GTK_WIDGET (self->face_row), visible);
+    if (!visible)
+        return;
+
+    path = g_strdup_printf (FACE_UNLOCK_STORE "/%s.npy", act_user_get_user_name (self->user));
+    cc_list_row_set_secondary_label (self->face_row,
+                                     g_file_test (path, G_FILE_TEST_EXISTS) ?
+                                     _("Enabled") : _("Disabled"));
+}
+
+static void
+change_face_unlock (CcUserPage *self)
+{
+    g_autoptr(GDesktopAppInfo) app = g_desktop_app_info_new (FACE_UNLOCK_APP);
+    g_autoptr(GdkAppLaunchContext) context = NULL;
+    g_autoptr(GError) error = NULL;
+
+    if (!app)
+        return;
+    context = gdk_display_get_app_launch_context (gtk_widget_get_display (GTK_WIDGET (self)));
+    if (!g_app_info_launch (G_APP_INFO (app), NULL, G_APP_LAUNCH_CONTEXT (context), &error))
+        g_warning ("Failed to start Face Unlock: %s", error->message);
+}
+
+/* Refresh the face row whenever the window becomes active again, e.g. after
+ * the Face Unlock window has been closed. */
+static void
+face_row_watch_window (CcUserPage *self)
+{
+    GtkRoot *root = gtk_widget_get_root (GTK_WIDGET (self));
+
+    if (self->face_row_watching || !GTK_IS_WINDOW (root))
+        return;
+    self->face_row_watching = TRUE;
+    g_signal_connect_object (root, "notify::is-active",
+                             G_CALLBACK (update_face_row_state), self,
+                             G_CONNECT_SWAPPED);
+}
