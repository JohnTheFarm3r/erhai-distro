-		update_slot_attribute(&disk, slot, ATTR_BOOTABLE);
+		/* Leave that to the bootloader (fastboot set_active). */
+		fprintf(stderr, "SLOT %s: marked unbootable, not touching it\n",
+			slot_suffix_arr[slot]);
+		ret = -1;
+		goto out;
 	}
 
