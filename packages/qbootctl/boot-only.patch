diff -ru a/bootctrl_impl.c b/bootctrl_impl.c
--- a/bootctrl_impl.c
+++ b/bootctrl_impl.c
@@ -202,6 +202,14 @@
 		else
 			partName = buf + strlen(BOOT_DEV_DIR) + 1;
 
+		/*
