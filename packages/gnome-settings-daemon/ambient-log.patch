+static gdouble
+ambient_curve (gdouble level)
+{
+        return CLAMP (GSD_AMBIENT_CURVE_BASE + GSD_AMBIENT_CURVE_SLOPE * level, 0.0, 100.0);
+}
+
+static gboolean ambient_glide_cb (gpointer user_data);
+
+/* Move the brightness towards the target for the current anchor, and keep
+ * moving between sensor readings until it arrives. */
+static void
+ambient_glide (GsdPowerManager *manager)
+{
+        gdouble goal = ambient_curve (manager->ambient_anchor);
+        gint64 now = g_get_monotonic_time ();
+
+        if (manager->ambient_glide_last_time) {
+                gdouble dt = now - manager->ambient_glide_last_time;
+                gdouble beta = dt / (dt + GSD_AMBIENT_GLIDE_TIME_CONSTANT);
+
+                manager->ambient_accumulator += beta * (goal - manager->ambient_accumulator);
+        }
+        manager->ambient_glide_last_time = now;
+        if (fabs (goal - manager->ambient_accumulator) < 0.2)
+                manager->ambient_accumulator = goal;
+
+        if (now - manager->ambient_set_last_time >= GSD_AMBIENT_SEND_UPDATE_INTERVAL ||
+            manager->ambient_accumulator == goal) {
+                shell_brightness_set_auto_target (manager,
+                                                  manager->ambient_accumulator / 100.0);
+                manager->ambient_set_last_time = now;
+        }
+
+        if (manager->ambient_accumulator != goal) {
+                if (!manager->ambient_glide_id)
+                        manager->ambient_glide_id = g_timeout_add (100, ambient_glide_cb, manager);
+        } else {
+                g_clear_handle_id (&manager->ambient_glide_id, g_source_remove);
+                manager->ambient_glide_last_time = 0;
+        }
+}
+
+static gboolean
+ambient_glide_cb (gpointer user_data)
+{
+        GsdPowerManager *manager = user_data;
+
+        manager->ambient_glide_id = 0;
+        if (g_settings_get_boolean (manager->settings, "ambient-enabled") &&
+            manager->ambient_accumulator >= 0.f)
+                ambient_glide (manager);
+        return G_SOURCE_REMOVE;
+}
