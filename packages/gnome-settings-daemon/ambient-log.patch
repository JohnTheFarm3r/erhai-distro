+/* Auto brightness follows the logarithm of the light level, as the eye
+ * does: a fixed brightness step for each tenfold change of light. The
+ * slider in the shell adds its bias on top. */
+#define GSD_AMBIENT_CURVE_BASE         15.0    /* percent in darkness */
+#define GSD_AMBIENT_CURVE_SLOPE        20.0    /* percent per tenfold light */
+/* Smoothing of the light level, so flicker and brief shadows pass. */
+#define GSD_AMBIENT_LEVEL_TIME_CONSTANT (G_USEC_PER_SEC * 3.0)
+/* The target moves only once the smoothed light level has changed by more
+ * than this many decades (0.35 is a factor of 2.2): a face lit a little
+ * more or a screen in the background does not move it, a lamp switched
+ * on or a window does. It then follows the light until it settles. */
+#define GSD_AMBIENT_DEADBAND           0.35
+#define GSD_AMBIENT_SETTLED            0.05
+/* Glide time towards a new target. */
+#define GSD_AMBIENT_GLIDE_TIME_CONSTANT (G_USEC_PER_SEC * 1.5)
 
