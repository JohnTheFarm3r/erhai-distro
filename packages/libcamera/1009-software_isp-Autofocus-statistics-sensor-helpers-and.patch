+/*
+ * Autofocus contrast, inside the centre half of the window: each sampled
+ * block contributes the sum of two green samples, and the difference
+ * between the sums over two neighbouring runs of afBox blocks is squared.
+ * Averaging over blocks makes this a band pass that follows image detail
+ * rather than pixel noise, which dominates single pixel differences in
+ * low light. \a pos is the sample position in the units of the loop and
+ * \a start and \a end bound the window in them.
+ */
+#define SWSTATS_ACCUMULATE_AF(ga, gb, pos, start, end)                    \
+	if (afLine && (pos) >= (start) && (pos) < (end)) {                  \
+		afRing[afIdx & 15] = static_cast<uint32_t>(ga) + (gb);      \
+		afIdx++;                                                   \
+		if (afIdx >= 2 * afBox) {                                  \
+			int64_t older = 0, newer = 0;                      \
+			for (unsigned int k = 0; k < afBox; k++) {         \
+				older += afRing[(afIdx - 2 * afBox + k) & 15]; \
+				newer += afRing[(afIdx - afBox + k) & 15]; \
+			}                                                  \
+			const int64_t d = newer - older;                   \
+			afGradient += d * d;                               \
+			afSum += newer;                                    \
+			afCount++;                                         \
+		}                                                          \
+	}
+
 #define SWSTATS_FINISH_LINE_STATS() \
 	stats.sum_.r() += sumR;     \
 	stats.sum_.g() += sumG;     \
 	stats.sum_.b() += sumB;     \
-	stats.numPixels_ += nSamples;
+	stats.numPixels_ += nSamples; \
+	stats.afGradient += afGradient; \
+	stats.afSum += afSum;         \
+	stats.afCount += afCount;
 
