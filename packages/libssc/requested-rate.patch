Let a client request a sample rate.

Keep every sample rate the sensor lists and stream at the slowest one
that meets a "requested-rate" set by the client, so a motion client can
ask for a faster gyroscope while other clients keep the default rate.
Declare "sample-rate" as the float it holds.

--- a/src/libssc-sensor.c	2026-11-19 05:33:27.270223614 +0100
+++ b/src/libssc-sensor.c	2026-11-19 05:33:49.586233782 +0100
@@ -36,6 +36,7 @@
 	PROP_CLIENT = 9,
 	PROP_FILE = 10,
 	PROP_MOUNT_MATRIX = 11,
+	PROP_REQUESTED_RATE = 12,
 	N_PROPERTIES
 };
 static GParamSpec *properties[N_PROPERTIES];
@@ -54,6 +55,9 @@
 	guint stream_type;
 	gboolean available;
 	gfloat sample_rate;
+	gfloat rates[16];
+	guint n_rates;
+	gfloat requested_rate;
 	gfloat mount_matrix[3][3];
 
 	SSCClient *client;
@@ -217,6 +221,20 @@
 		}
 
 		msg.sample_rate = priv->sample_rate;
+		/* A client may ask for a faster rate: use the slowest listed
+		 * rate that meets it, or the fastest one. */
+		if (priv->requested_rate > 0.0 && priv->n_rates > 0) {
+			gfloat pick = 0.0;
+
+			for (guint k = 0; k < priv->n_rates; k++)
+				if (priv->rates[k] >= priv->requested_rate &&
+				    (pick == 0.0 || priv->rates[k] < pick))
+					pick = priv->rates[k];
+			if (pick == 0.0)
+				for (guint k = 0; k < priv->n_rates; k++)
+					pick = MAX (pick, priv->rates[k]);
+			msg.sample_rate = pick;
+		}
 		buf = g_array_new (FALSE, FALSE, 1);
 		g_array_set_size (buf, ssc_enable_config_request__get_packed_size (&msg));
 		ssc_enable_config_request__pack (&msg, (unsigned char*) buf->data);
@@ -384,12 +402,18 @@
 						priv->available = attr_msg->attr[i]->value_array->v[0]->b;
 					break;
 				case SSC_ATTRIBUTE_SAMPLE_RATE:
-					/* Only a single sample rate is supported for now. */
+					/* The first rate is the default; all are kept for
+					 * clients that request a rate. */
+					priv->n_rates = 0;
 					for (gsize j = 0; j < attr_msg->attr[i]->value_array->n_v; j++) {
 						if (attr_msg->attr[i]->value_array->v[j]->has_f
 						 && attr_msg->attr[i]->value_array->v[j]->f > 0) {
-							priv->sample_rate = attr_msg->attr[i]->value_array->v[j]->f;
-							break;
+							gfloat f = attr_msg->attr[i]->value_array->v[j]->f;
+
+							if (priv->n_rates == 0)
+								priv->sample_rate = f;
+							if (priv->n_rates < G_N_ELEMENTS (priv->rates))
+								priv->rates[priv->n_rates++] = f;
 						}
 					}
 					break;
@@ -731,6 +755,9 @@
 		case PROP_CLIENT:
 			priv->client = g_value_dup_object (value);
 			break;
+		case PROP_REQUESTED_RATE:
+			priv->requested_rate = g_value_get_float (value);
